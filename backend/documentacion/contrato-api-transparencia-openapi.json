        "parameters": [
          {
            "$ref": "#/components/parameters/Ejercicio"
          },
          {
            "$ref": "#/components/parameters/SeccionId"
          },
          {
            "$ref": "#/components/parameters/Buscar"
          },
          {
            "$ref": "#/components/parameters/Periodo"
          },
          {
            "$ref": "#/components/parameters/EstadoPublicacion"
          }
        ],
        "responses": {
