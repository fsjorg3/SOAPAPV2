{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "API de Transparencia Financiera SOAPAP",
    "version": "1.0.0",
    "description": "Contrato público para consultar documentos de transparencia por ejercicio fiscal y sección.\n\nEl mismo detalle de sección alimenta la matriz de escritorio y las tarjetas móviles.\n`presentacion.tipo` indica si la sección se representa como matriz de periodos o como\ndocumentos anuales simples.\n",
    "contact": {
      "name": "SOAPAP"
    }
  },
  "servers": [
    {
      "url": "https://soapap.gob.mx/api/v1",
      "description": "Producción"
    }
  ],
  "tags": [
    {
      "name": "Catálogo",
      "description": "Ejercicios fiscales y secciones disponibles."
    },
    {
      "name": "Documentos",
      "description": "Documentos financieros y sus publicaciones por periodo."
    },
    {
      "name": "Archivos",
      "description": "Visualización y descarga de archivos PDF."
    }
  ],
  "paths": {
    "/transparencia/ejercicios": {
      "get": {
        "tags": [
          "Catálogo"
        ],
        "operationId": "listarEjercicios",
        "summary": "Lista los ejercicios fiscales disponibles",
        "responses": {
          "200": {
            "description": "Ejercicios recuperados correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaEjercicios"
                },
                "example": {
                  "data": [
                    {
                      "ejercicio": 2026,
                      "estado": "publicado"
                    },
                    {
                      "ejercicio": 2025,
                      "estado": "publicado"
                    },
                    {
                      "ejercicio": 2024,
                      "estado": "publicado"
                    }
                  ],
                  "meta": {
                    "generadoEn": "2026-09-03T18:00:00Z"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          }
        }
      }
    },
    "/transparencia/ejercicios/{ejercicio}/secciones": {
      "get": {
        "tags": [
          "Catálogo"
        ],
        "operationId": "listarSecciones",
        "summary": "Lista las secciones de un ejercicio fiscal",
        "parameters": [
          {
            "$ref": "#/components/parameters/Ejercicio"
          }
        ],
        "responses": {
          "200": {
            "description": "Secciones recuperadas correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaSecciones"
                },
                "example": {
                  "data": {
                    "ejercicio": 2026,
                    "secciones": [
                      {
                        "id": "estados_financieros",
                        "titulo": "Estados financieros, contables, presupuestales y programáticos",
                        "orden": 1,
                        "periodicidad": "trimestral",
                        "presentacion": {
                          "tipo": "matriz_periodos",
                          "mostrarFiltroPeriodo": true
                        },
                        "totalDocumentos": 21,
                        "totalArchivosPublicados": 38
                      },
                      {
                        "id": "notas_estados_financieros",
                        "titulo": "Notas a los Estados Financieros",
                        "orden": 3,
                        "periodicidad": "anual",
                        "presentacion": {
                          "tipo": "documentos_simples",
                          "mostrarFiltroPeriodo": false
                        },
                        "totalDocumentos": 6,
                        "totalArchivosPublicados": 6
                      }
                    ]
                  },
                  "meta": {
                    "generadoEn": "2026-09-03T18:00:00Z"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrado"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          }
        }
      }
    },
    "/transparencia/ejercicios/{ejercicio}/secciones/{seccionId}": {
