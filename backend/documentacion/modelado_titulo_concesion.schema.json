{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soapap.gob.mx/schemas/modelado_titulo_concesion.schema.json",
  "title": "Modelado del catálogo de Título de concesión",
  "description": "Estructura fuente (grupo -> documento principal + anexos) que alimenta el contrato de la API de título de concesión. Cada grupo representa un título/convenio y sus anexos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["grupos"],
  "properties": {
    "grupos": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Grupo" }
    }
  },
  "$defs": {
    "Identificador": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "EstadoPublicacion": {
      "type": "string",
      "enum": ["pendiente", "publicado", "retirado"]
    },
    "RutaArchivo": {
      "type": "string",
      "pattern": "^([A-Za-z0-9_-]+/)?[A-Za-z0-9_-]+\\.pdf$"
    },
    "Grupo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titulo", "orden", "documentoPrincipal", "anexos"],
      "properties": {
        "id": { "$ref": "#/$defs/Identificador" },
        "titulo": { "type": "string", "minLength": 1, "maxLength": 300 },
        "orden": { "type": "integer", "minimum": 1 },
        "documentoPrincipal": { "$ref": "#/$defs/Documento" },
        "anexos": {
          "type": "array",
          "items": { "$ref": "#/$defs/Documento" }
        }
      }
    },
    "Documento": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titulo", "orden", "link", "estado"],
      "properties": {
        "id": { "$ref": "#/$defs/Identificador" },
        "titulo": { "type": "string", "minLength": 1, "maxLength": 300 },
        "orden": { "type": "integer", "minimum": 1 },
        "link": {
          "oneOf": [{ "$ref": "#/$defs/RutaArchivo" }, { "type": "null" }]
        },
        "estado": { "$ref": "#/$defs/EstadoPublicacion" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "estado": { "const": "publicado" } },
            "required": ["estado"]
          },
          "then": {
            "properties": { "link": { "$ref": "#/$defs/RutaArchivo" } }
          }
        },
        {
          "if": {
            "properties": { "estado": { "enum": ["pendiente", "retirado"] } },
            "required": ["estado"]
          },
          "then": {
            "properties": { "link": { "type": "null" } }
          }
        }
      ]
    }
  }
}
