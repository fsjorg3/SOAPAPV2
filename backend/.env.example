PORT=3000
NODE_ENV=development
PDF_STORAGE_PATH=./assets
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Seguridad y Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=2000
RATE_LIMIT_ASSETS_MAX=20000

# SMTP (formulario de contacto)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=

# Rate limiting específico del formulario de contacto
RATE_LIMIT_CONTACT_MAX=2
RATE_LIMIT_CONTACT_WINDOW_MS=300000
